{
  "schemaVersion": 1,
  "id": "hebrewfix",
  "version": "${version}",
  "name": "HebrewFix",
  "description": "Fixes RTL Hebrew chat preview rendering in Minecraft.",
  "authors": ["Yali Gaming"],
  "contact": {
    "homepage": "https://modrinth.com/mod/hebrewfix",
    "sources": "https://github.com/YaliGaming/hebrewfix",
    "issues": "https://github.com/YaliGaming/hebrewfix/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.yaligaming.hebrewfix.HebrewFixMod"
    ],
    "modmenu": [
      "com.yaligaming.hebrewfix.ModMenuIntegration"
    ]
  },
  "mixins": [
    "hebrewfix.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
